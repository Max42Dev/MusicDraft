<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicDraft.App.ViewModels"
             x:Class="MusicDraft.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer>
        <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Classes="h1" Text="Settings" />

            <!-- Generation -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Detect again" Command="{Binding DetectCommand}" />
                        <TextBlock Text="Music generation" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding Hub.HardwareText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Hub.RecommendationText}" TextWrapping="Wrap" Classes="subtle" />

                    <TextBlock Text="Model profile" Margin="0,6,0,0" />
                    <ComboBox ItemsSource="{Binding Hub.Profiles}" SelectedItem="{Binding Hub.SelectedProfile}" MinWidth="420"
                              IsEnabled="{Binding !Hub.IsSettingUp}" AutomationProperties.Name="Model profile" />
                    <TextBlock Text="{Binding Hub.SelectedWarning}" TextWrapping="Wrap" Foreground="#D9822B"
                               IsVisible="{Binding Hub.SelectedWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <Border Background="{DynamicResource InfoBackground}" CornerRadius="8" Padding="12,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="icon" Text="&#xE946;" />
                            <TextBlock Text="{Binding Hub.ReadinessText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Setup progress -->
                    <StackPanel Spacing="6" IsVisible="{Binding Hub.IsSettingUp}">
                        <TextBlock Text="{Binding Hub.SetupStep}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <ProgressBar Value="{Binding Hub.SetupFraction}" IsIndeterminate="{Binding Hub.SetupIndeterminate}" Maximum="100" Height="6" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding Hub.CancelSetupCommand}" />
                            <TextBlock Text="{Binding Hub.SetupDetail}" Classes="subtle" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap"
                                   Text="You can keep listening to music while this runs. Cancelled downloads resume where they stopped." />
                    </StackPanel>
                    <TextBlock Text="{Binding Hub.SetupError}" TextWrapping="Wrap" Foreground="#E0556A"
                               IsVisible="{Binding Hub.SetupError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !Hub.IsSettingUp}">
                        <Button Classes="accent" Content="Set up generation…" Command="{Binding SetUpCommand}"
                                IsVisible="{Binding !Hub.Readiness.CanGenerate}" />
                        <Button Content="Verify files" Command="{Binding VerifyCommand}" IsEnabled="{Binding !Busy}" />
                        <Button Content="Remove model…" Command="{Binding RemoveModelCommand}" IsVisible="{Binding Hub.Readiness.GeneratorPresent}" />
                        <Button Content="Model license" Command="{Binding OpenLicenseCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Local lyrics assistant -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Lyrics assistant" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap"
                               Text="A small local model (Gemma 4 E2B, Q4) that drafts a verse and chorus from a short prompt on the Create screen. It runs on this PC with llama.cpp and never uploads anything." />
                    <TextBlock Text="{Binding LyricsAssistantStatus}" TextWrapping="Wrap" Classes="subtle" />

                    <StackPanel Spacing="6" IsVisible="{Binding Hub.IsSettingUpLyrics}">
                        <TextBlock Text="{Binding Hub.LyricsSetupStep}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <ProgressBar Value="{Binding Hub.LyricsSetupFraction}" IsIndeterminate="{Binding Hub.LyricsSetupIndeterminate}" Maximum="100" Height="6" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding Hub.CancelLyricsSetupCommand}" />
                            <TextBlock Text="{Binding Hub.LyricsSetupDetail}" Classes="subtle" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding Hub.LyricsSetupError}" TextWrapping="Wrap" Foreground="#E0556A"
                               IsVisible="{Binding Hub.LyricsSetupError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !Hub.IsSettingUpLyrics}">
                        <Button Classes="accent" Content="Download lyrics assistant…" Command="{Binding SetUpLyricsAssistantCommand}"
                                IsVisible="{Binding !LyricsAssistantReady}" />
                        <Button Content="Verify files" Command="{Binding VerifyLyricsAssistantCommand}" IsEnabled="{Binding !Busy}" />
                        <Button Content="Remove…" Command="{Binding RemoveLyricsAssistantCommand}" IsVisible="{Binding LyricsAssistantReady}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Storage -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="Storage" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Classes="subtle" Text="App data (catalog, runtime, models, job records)" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Open" Command="{Binding OpenDataFolderCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding DataFolder}" IsReadOnly="True" AutomationProperties.Name="App data folder" />
                    </DockPanel>
                    <TextBlock Classes="subtle" Text="Generated songs" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Open" Command="{Binding OpenLibraryFolderCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding LibraryFolder}" IsReadOnly="True" AutomationProperties.Name="Generated songs folder" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="6">
                    <TextBlock Text="Privacy and rights" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap"
                               Text="Everything runs on this PC. MusicDraft references your files in place, never modifies them and never uploads audio, prompts or lyrics. The small lyrics assistant downloads automatically from its pinned source; music models download only after you agree to the sources shown before setup." />
                    <TextBlock TextWrapping="Wrap" Classes="subtle"
                               Text="YuE2 model weights are CC BY-NC 4.0 with permission for individual creators to monetise outputs. Company-commercial use is not covered. You are responsible for the rights to lyrics and reference material you use." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
