<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained win-x64 publish profile.

  Folder publish (not single-file) on purpose: LLamaSharp ships native llama.cpp binaries and
  Avalonia ships native libs; keeping them as loose files avoids per-launch extraction to %TEMP%
  and is the most reliable layout for an installer. The installer still presents a single
  user-visible launch EXE (MusicDraft.exe) via the Start Menu / desktop shortcut.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <!-- Native NuGet packages (SkiaSharp, HarfBuzzSharp) ship large .pdb files that DebugType
         does not strip; drop all reference-related files to keep the installer small. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>bin\Release\net10.0-windows\win-x64\publish\</PublishDir>
  </PropertyGroup>
</Project>
