<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MusicDraft.App.App"
             Name="MusicDraft"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ShellBackground" Color="#F4F5F8" />
                    <SolidColorBrush x:Key="SidebarBackground" Color="#ECEEF3" />
                    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TransportBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SubtleText" Color="#5F6573" />
                    <SolidColorBrush x:Key="Divider" Color="#DDE0E7" />
                    <SolidColorBrush x:Key="RowHover" Color="#0F000000" />
                    <SolidColorBrush x:Key="ErrorBackground" Color="#FDE7E9" />
                    <SolidColorBrush x:Key="InfoBackground" Color="#E6EEFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ShellBackground" Color="#16171C" />
                    <SolidColorBrush x:Key="SidebarBackground" Color="#1C1D23" />
                    <SolidColorBrush x:Key="CardBackground" Color="#22242B" />
                    <SolidColorBrush x:Key="TransportBackground" Color="#1E1F26" />
                    <SolidColorBrush x:Key="SubtleText" Color="#A3A8B5" />
                    <SolidColorBrush x:Key="Divider" Color="#30323B" />
                    <SolidColorBrush x:Key="RowHover" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="ErrorBackground" Color="#442127" />
                    <SolidColorBrush x:Key="InfoBackground" Color="#1F2B45" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Color x:Key="SystemAccentColor">#6C5CE7</Color>
            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="TextBlock.icon">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.subtle">
            <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
        </Style>
        <Style Selector="Button.transport">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.transport.active TextBlock.icon">
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="Button.play">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style Selector="ListBox.tracks > ListBoxItem">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="ListBoxItem.drag-target">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="ListBoxItem.drag-target TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBlock.current">
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Application.Styles>
</Application>